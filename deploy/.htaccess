# Hostinger (Apache). Ajustar DOMINIO.
RewriteEngine On
# HTTPS + domínio canônico sem www [VALIDAR preferência www/sem www]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://DOMINIO%{REQUEST_URI} [L,R=301]
# Barra final nas pastas
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^.]*[^/])$ /$1/ [L,R=301]
ErrorDocument 404 /404.html
# Redirects do domínio/URLs antigas (Somos Ajuda): mapear 1:1 quando houver URLs com backlinks. Nunca tudo para a Home.
# Redirect 301 /servico-antigo/ https://DOMINIO/servicos/
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(avif|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
